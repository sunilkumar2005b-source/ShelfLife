# ShelfLife - Backend Environment Variables
# Copy this file to .env and adjust credentials as needed

# PostgreSQL Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=shelflife_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here

# Backend Service Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
