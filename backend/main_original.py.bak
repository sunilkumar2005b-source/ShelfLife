@app.get("/spoilage-predictions")
def get_spoilage_predictions():
    connection = None
    cursor = None

    try:
        connection = get_connection()
        cursor = connection.cursor()

        cursor.execute("""
            SELECT
                sp.prediction_id,
                sp.product_id,
                p.product_name,
                p.category,
                sp.inventory_id,
                sp.prediction_date,
                sp.days_remaining,
                sp.spoilage_probability,
                sp.risk_level,
                sp.model_name
            FROM spoilage_predictions sp
            JOIN products p
                ON sp.product_id = p.product_id
            ORDER BY sp.prediction_id
        """)

        rows = cursor.fetchall()

        predictions = []

        for row in rows:
            probability = float(row[7])

            predictions.append({
                "prediction_id": row[0],
                "product_id": row[1],
                "product_name": row[2],
                "category": row[3],
                "inventory_id": row[4],
                "prediction_date": str(row[5]),
                "days_remaining": int(row[6]),
                "spoilage_probability": probability,
                "risk_level": row[8],
                "model_name": row[9]
            })

        return predictions

    except Exception as error:
        raise HTTPException(
            status_code=500,
            detail=f"Unable to load spoilage predictions: {str(error)}"
        )

    finally:
        close_database(connection, cursor)


# ============================================================
# DASHBOARD SUMMARY API
# ============================================================

@app.get("/dashboard-summary")
def get_dashboard_summary():
    """
    Provides summary values used by the Dashboard.
    """

    connection = None
    cursor = None

    try:
        connection = get_connection()
        cursor = connection.cursor()

        # Total products
        cursor.execute("""
            SELECT COUNT(*)
            FROM products
        """)

        total_products = cursor.fetchone()[0]

        # Total inventory records
        cursor.execute("""
            SELECT COUNT(*)
            FROM inventory
        """)

        inventory_items = cursor.fetchone()[0]

        # Risk counts
        cursor.execute("""
            SELECT
                LOWER(risk_level),
                COUNT(*)
            FROM spoilage_predictions
            GROUP BY LOWER(risk_level)
        """)

        risk_rows = cursor.fetchall()

        high_risk = 0
        medium_risk = 0
        low_risk = 0

        for risk, count in risk_rows:

            if risk == "high":
                high_risk = int(count)

            elif risk == "medium":
                medium_risk = int(count)

            elif risk == "low":
                low_risk = int(count)

        return {
            "total_products": total_products,
            "inventory_items": inventory_items,
            "high_spoilage_risk": high_risk,
            "medium_risk": medium_risk,
            "low_risk": low_risk,
            "risk_summary": {
                "high": high_risk,
                "medium": medium_risk,
                "low": low_risk
            }
        }

    except Exception as error:
        raise HTTPException(
            status_code=500,
            detail=f"Unable to load dashboard summary: {str(error)}"
        )

    finally:
        close_database(connection, cursor)


# ============================================================
# INVENTORY INTELLIGENCE API
# ============================================================

@app.get("/inventory-intelligence")
def get_inventory_intelligence():
    """
    Combines:

    Products
    + Inventory
    + Demand Forecast
    + Spoilage Prediction

    to generate the final inventory recommendation.
    """

    connection = None
    cursor = None

    try:
        connection = get_connection()
        cursor = connection.cursor()

        cursor.execute("""
            SELECT
                i.inventory_id,
                i.product_id,
                p.product_name,
                i.quantity,
                i.expiry_date,

                COALESCE(
                    (
                        SELECT df.predicted_demand
                        FROM demand_forecasts df
                        WHERE df.product_id = i.product_id
                        ORDER BY df.forecast_date DESC
                        LIMIT 1
                    ),
                    0
                ) AS predicted_demand,

                COALESCE(
                    (
                        SELECT sp.spoilage_probability
                        FROM spoilage_predictions sp
                        WHERE sp.product_id = i.product_id
                        AND sp.inventory_id = i.inventory_id
                        ORDER BY sp.prediction_date DESC
                        LIMIT 1
                    ),
                    0
                ) AS spoilage_probability

            FROM inventory i

            JOIN products p
                ON i.product_id = p.product_id

            ORDER BY i.inventory_id
        """)

        rows = cursor.fetchall()

        intelligence = []

        for row in rows:

            inventory_id = row[0]
            product_id = row[1]
            product_name = row[2]
            current_stock = float(row[3])
            expiry_date = row[4]
            predicted_demand = float(row[5])
            spoilage_probability = float(row[6])

            # ------------------------------------------------
            # Days remaining
            # ------------------------------------------------

            days_remaining = days_until_expiry(expiry_date)

            # ------------------------------------------------
            # Risk
            # ------------------------------------------------

            risk_level = get_spoilage_risk(
                spoilage_probability
            )

            # ------------------------------------------------
            # Health score
            # ------------------------------------------------

            score = calculate_health_score(
                current_stock=current_stock,
                predicted_demand=predicted_demand,
                days_remaining=days_remaining,
                spoilage_probability=spoilage_probability
            )

            status = health_status(score)

            # ------------------------------------------------
            # Recommendation
            # ------------------------------------------------

            recommendation, explanation = get_recommendation(
                current_stock=current_stock,
                predicted_demand=predicted_demand,
                days_remaining=days_remaining,
                spoilage_probability=spoilage_probability
            )

            intelligence.append({

                "inventory_id": inventory_id,

                "product_id": product_id,

                "product_name": product_name,

                "current_stock": int(current_stock),

                "predicted_demand": int(predicted_demand),

                "expiry_date": str(expiry_date),

                "days_remaining": days_remaining,

                "spoilage_probability": round(
                    spoilage_probability,
                    2
                ),

                "spoilage_probability_percent": round(
                    spoilage_probability * 100,
                    1
                ),

                "risk_level": risk_level,

                "health_score": score,

                "health_status": status,

                "recommendation": recommendation,

                "ai_explanation": explanation
            })

        return intelligence

    except Exception as error:
        raise HTTPException(
            status_code=500,
            detail=f"Unable to generate inventory intelligence: {str(error)}"
        )

    finally:
        close_database(connection, cursor)


# ============================================================
# INVENTORY INTELLIGENCE SUMMARY
# ============================================================

@app.get("/inventory-intelligence-summary")
def get_inventory_intelligence_summary():
    """
    Provides counts for:

    Urgent Clearance
    Sell Quickly
    Reorder
    Monitor
    Sufficient
    """

    try:

        data = get_inventory_intelligence()

        urgent_clearance = 0
        sell_quickly = 0
        reorder = 0
        monitor = 0
        sufficient = 0

        for item in data:

            recommendation = item["recommendation"]

            if recommendation == "Urgent Clearance":
                urgent_clearance += 1

            elif recommendation == "Sell Quickly":
                sell_quickly += 1

            elif recommendation == "Reorder":
                reorder += 1

            elif recommendation == "Monitor Stock":
                monitor += 1

            elif recommendation == "Sufficient Stock":
                sufficient += 1

        return {
            "urgent_clearance": urgent_clearance,
            "sell_quickly": sell_quickly,
            "reorder": reorder,
            "monitor": monitor,
            "sufficient": sufficient,
            "total": len(data)
        }

    except Exception as error:
        raise HTTPException(
            status_code=500,
            detail=f"Unable to generate intelligence summary: {str(error)}"
        )


