from datetime import date
from typing import Any

from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware

from database import get_connection


# ============================================================
# SHELFLIFE FASTAPI APPLICATION
# ============================================================

app = FastAPI(
    title="ShelfLife API",
    description="Perishable Inventory Management System API",
    version="1.0.0"
)


# ============================================================
# CORS CONFIGURATION
# ============================================================

app.add_middleware(
    CORSMiddleware,
   allow_origins=[
    "http://localhost:5175",
    "http://localhost:5174",
    "http://localhost:5173",
    "http://127.0.0.1:5175",
    "http://127.0.0.1:5174",
    "http://127.0.0.1:5173",
],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


# ============================================================
# HELPER FUNCTIONS
# ============================================================

def close_database(connection, cursor):
    """
    Safely close cursor and database connection.
    """
    try:
        if cursor is not None:
            cursor.close()
    except Exception:
        pass

    try:
        if connection is not None:
            connection.close()
    except Exception:
        pass


def days_until_expiry(expiry_date):
    """
    Calculate number of days remaining until expiry.
    """
    if expiry_date is None:
        return 0

    if isinstance(expiry_date, str):
        expiry_date = date.fromisoformat(expiry_date)

    return max((expiry_date - date.today()).days, 0)


def calculate_health_score(
    current_stock: float,
    predicted_demand: float,
    days_remaining: int,
    spoilage_probability: float
) -> int:
    """
    Calculate inventory health score from 0-100.

    Higher score = healthier inventory.
    Lower score = greater attention required.
    """

    # --------------------------------------------------------
    # 1. Stock coverage score
    # --------------------------------------------------------

    if predicted_demand <= 0:
        stock_score = 100
    else:
        stock_ratio = current_stock / predicted_demand

        if stock_ratio >= 2.0:
            stock_score = 100
        elif stock_ratio >= 1.5:
            stock_score = 90
        elif stock_ratio >= 1.0:
            stock_score = 75
        elif stock_ratio >= 0.75:
            stock_score = 55
        elif stock_ratio >= 0.50:
            stock_score = 35
        else:
            stock_score = 20

    # --------------------------------------------------------
    # 2. Expiry score
    # --------------------------------------------------------

    if days_remaining <= 0:
        expiry_score = 0
    elif days_remaining == 1:
        expiry_score = 20
    elif days_remaining == 2:
        expiry_score = 35
    elif days_remaining == 3:
        expiry_score = 50
    elif days_remaining <= 5:
        expiry_score = 65
    elif days_remaining <= 7:
        expiry_score = 80
    elif days_remaining <= 14:
        expiry_score = 90
    else:
        expiry_score = 100

    # --------------------------------------------------------
    # 3. Spoilage score
    # --------------------------------------------------------

    probability = max(0.0, min(float(spoilage_probability), 1.0))

    spoilage_score = (1.0 - probability) * 100

    # --------------------------------------------------------
    # Weighted final score
    # --------------------------------------------------------

    score = (
        stock_score * 0.30
        + expiry_score * 0.35
        + spoilage_score * 0.35
    )

    return max(0, min(100, round(score)))


def health_status(score: int) -> str:
    """
    Convert health score into a readable status.
    """

    if score >= 75:
        return "Healthy"

    if score >= 50:
        return "Needs Attention"

    return "Critical"


def get_recommendation(
    current_stock: float,
    predicted_demand: float,
    days_remaining: int,
    spoilage_probability: float
) -> tuple[str, str]:
    """
    Generate inventory recommendation and explanation.
    """

    probability_percent = spoilage_probability * 100

    # --------------------------------------------------------
    # URGENT CLEARANCE
    # --------------------------------------------------------

    if days_remaining <= 1 and probability_percent >= 70:
        recommendation = "Urgent Clearance"

        explanation = (
            f"{int(current_stock)} units are currently in stock, "
            f"while predicted demand is {int(predicted_demand)} units. "
            f"Spoilage probability is {probability_percent:.0f}%. "
            f"The product expires in {days_remaining} day(s). "
            f"Immediate clearance is recommended to reduce wastage."
        )

        return recommendation, explanation

    # --------------------------------------------------------
    # SELL QUICKLY
    # --------------------------------------------------------

    if (
        days_remaining <= 3
        and probability_percent >= 60
        and current_stock > predicted_demand
    ):
        recommendation = "Sell Quickly"

        explanation = (
            f"{int(current_stock)} units are in stock, while predicted "
            f"demand is only {int(predicted_demand)} units. "
            f"Spoilage probability is {probability_percent:.0f}% "
            f"with {days_remaining} day(s) remaining. "
            f"Prioritize selling this product quickly."
        )

        return recommendation, explanation

    # --------------------------------------------------------
    # REORDER
    # --------------------------------------------------------

    if current_stock < predicted_demand:
        reorder_quantity = max(
            round(predicted_demand - current_stock),
            0
        )

        recommendation = "Reorder"

        explanation = (
            f"Current stock is {int(current_stock)} units, "
            f"while predicted demand is {int(predicted_demand)} units. "
            f"Stock may not be sufficient for expected demand. "
            f"Consider ordering approximately {reorder_quantity} more unit(s)."
        )

        return recommendation, explanation

    # --------------------------------------------------------
    # MONITOR STOCK
    # --------------------------------------------------------

    if days_remaining <= 5 or probability_percent >= 40:
        recommendation = "Monitor Stock"

        explanation = (
            f"{int(current_stock)} units are currently available "
            f"compared with predicted demand of {int(predicted_demand)} units. "
            f"Stock is currently sufficient, but the product has "
            f"{days_remaining} day(s) remaining before expiry. "
            f"Monitor sales and avoid unnecessary additional purchases."
        )

        return recommendation, explanation

    # --------------------------------------------------------
    # SUFFICIENT STOCK
    # --------------------------------------------------------

    recommendation = "Sufficient Stock"

    explanation = (
        f"Current stock is {int(current_stock)} units, compared "
        f"with predicted demand of {int(predicted_demand)} units. "
        f"The available stock is sufficient for expected demand. "
        f"The product has {days_remaining} day(s) remaining before expiry."
    )

    return recommendation, explanation


def get_spoilage_risk(probability: float) -> str:
    """
    Convert spoilage probability to risk level.

    probability is expected as decimal:
    0.75 = 75%
    """

    probability_percent = probability * 100

    if probability_percent >= 60:
        return "High"

    if probability_percent >= 30:
        return "Medium"

    return "Low"


# ============================================================
# HOME / HEALTH CHECK
# ============================================================

@app.get("/")
def home():
    return {
        "message": "ShelfLife API is running successfully!",
        "status": "online",
        "version": "1.0.0"
    }


@app.get("/health")
def health_check():
    """
    Check whether backend and database are working.
    """

    connection = None
    cursor = None

    try:
        connection = get_connection()
        cursor = connection.cursor()

        cursor.execute("SELECT 1")
        cursor.fetchone()

        return {
            "status": "healthy",
            "backend": "online",
            "database": "connected"
        }

    except Exception as error:
        return {
            "status": "unhealthy",
            "backend": "online",
            "database": "disconnected",
            "error": str(error)
        }

    finally:
        close_database(connection, cursor)


# ============================================================
# PRODUCTS API
# ============================================================

@app.get("/products")
def get_products():
    connection = None
    cursor = None

    try:
        connection = get_connection()
        cursor = connection.cursor()

        cursor.execute("""
            SELECT
                product_id,
                product_name,
                category,
                unit,
                purchase_price,
                selling_price,
                shelf_life_days
            FROM products
            ORDER BY product_id
        """)

        rows = cursor.fetchall()

        products = []

        for row in rows:
            products.append({
                "product_id": row[0],
                "product_name": row[1],
                "category": row[2],
                "unit": row[3],
                "purchase_price": float(row[4]),
                "selling_price": float(row[5]),
                "shelf_life_days": int(row[6])
            })

        return products

    except Exception as error:
        raise HTTPException(
            status_code=500,
            detail=f"Unable to load products: {str(error)}"
        )

    finally:
        close_database(connection, cursor)


# ============================================================
# INVENTORY API
# ============================================================

@app.get("/inventory")
def get_inventory():
    connection = None
    cursor = None

    try:
        connection = get_connection()
        cursor = connection.cursor()

        cursor.execute("""
            SELECT
                i.inventory_id,
                i.product_id,
                p.product_name,
                p.category,
                i.batch_number,
                i.quantity,
                i.purchase_date,
                i.expiry_date,
                i.storage_temperature
            FROM inventory i
            JOIN products p
                ON i.product_id = p.product_id
            ORDER BY i.inventory_id
        """)

        rows = cursor.fetchall()

        inventory = []

        for row in rows:
            inventory.append({
                "inventory_id": row[0],
                "product_id": row[1],
                "product_name": row[2],
                "category": row[3],
                "batch_number": row[4],
                "quantity": int(row[5]),
                "purchase_date": str(row[6]),
                "expiry_date": str(row[7]),
                "storage_temperature": float(row[8])
            })

        return inventory

    except Exception as error:
        raise HTTPException(
            status_code=500,
            detail=f"Unable to load inventory: {str(error)}"
        )

    finally:
        close_database(connection, cursor)


