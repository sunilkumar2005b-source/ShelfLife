# ============================================================
# PURCHASE ORDERS API
# ============================================================

@app.get("/purchase-orders")
def get_purchase_orders():
    connection = None
    cursor = None

    try:
        connection = get_connection()
        cursor = connection.cursor()

        cursor.execute("""
            SELECT
                po.purchase_order_id,
                po.supplier_id,
                s.supplier_name,
                po.product_id,
                p.product_name,
                po.quantity_ordered,
                po.order_date,
                po.expected_delivery_date,
                po.status,
                po.unit_cost
            FROM purchase_orders po
            JOIN suppliers s
                ON po.supplier_id = s.supplier_id
            JOIN products p
                ON po.product_id = p.product_id
            ORDER BY po.purchase_order_id
        """)

        rows = cursor.fetchall()

        purchase_orders = []

        for row in rows:

            quantity = int(row[5])
            unit_cost = float(row[9])

            purchase_orders.append({
                "purchase_order_id": row[0],
                "supplier_id": row[1],
                "supplier_name": row[2],
                "product_id": row[3],
                "product_name": row[4],
                "quantity_ordered": quantity,
                "order_date": str(row[6]),
                "expected_delivery_date": str(row[7]),
                "status": row[8],
                "unit_cost": unit_cost,
                "total_cost": round(quantity * unit_cost, 2)
            })

        return purchase_orders

    except Exception as error:
        raise HTTPException(
            status_code=500,
            detail=f"Unable to load purchase orders: {str(error)}"
        )

    finally:
        close_database(connection, cursor)


