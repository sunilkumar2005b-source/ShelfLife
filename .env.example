# ============================================================
# ShelfLife - Environment Configuration Template
# Copy this file to .env and adjust values for your environment
# ============================================================

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=shelflife_db
DATABASE_USER=postgres
DATABASE_PASSWORD=PostgreSQL

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# Frontend Configuration
VITE_API_URL=http://127.0.0.1:8000

# Machine Learning Service (Future Integration)
ML_SERVICE_HOST=127.0.0.1
ML_SERVICE_PORT=8001
ML_SERVICE_URL=http://127.0.0.1:8001
